# ═══════════════════════════════════════════════════════════════════════════════
# AI-MILO Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════

# ── App & Security
APP_NAME=MILO AI Backend
APP_VERSION=0.1.0
DEBUG=false
JWT_SECRET_KEY=ganti-dengan-kunci-rahasia-acak-minimal-32-karakter-2026
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ── Database Configuration
# LOCAL DEV (MySQL - XAMPP / Laragon default: root, no password):
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/milo_db
DATABASE_URL_SYNC=mysql+pymysql://root:@localhost:3306/milo_db

# ALTERNATIVE (SQLite - No server required):
# DATABASE_URL=sqlite+aiosqlite:///./milo_dev.db
# DATABASE_URL_SYNC=sqlite:///./milo_dev.db

# CLOUD HOSTING (PostgreSQL - Supabase / Neon / Railway / RDS):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]
# DATABASE_URL_SYNC=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]

# ── AI Provider & LLM
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free

# ── Groq (Super Cepat & Gratis Kuota 14.400 request/hari)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Speech-to-Text (Whisper)
# LOCAL DEV (GPU RTX / CPU):
# WHISPER_PROVIDER=local
# WHISPER_MODEL_SIZE=small.en
# WHISPER_DEVICE=cuda

# CLOUD HOSTING (Tanpa butuh GPU di hosting, gratis via Groq API):
WHISPER_PROVIDER=groq
WHISPER_CLOUD_MODEL=whisper-large-v3-turbo

# ── Text-to-Speech (TTS)
TTS_MODEL=tts-1
TTS_VOICE=nova

# ── Knowledge Base (RAG ChromaDB)
CHROMA_DB_PATH=./knowledge_base/chroma_db
CHROMA_COLLECTION_NAME=cefr_knowledge
RAG_TOP_K=3
