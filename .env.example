# MILO AI Backend Environment Variables Template
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# ── AI Provider Mode ────────────────────────────────────────────────────────
# Options:
#   "bifrost"    - Gateway LLM (Bifrost) untuk token budgeting, rate limiting, & routing
#   "openrouter" - Cepat & GRATIS via cloud API (misal Nemotron, Gemma)
#   "local"      - Offline/Lokal menggunakan Ollama
#   "openai"     - OpenAI resmi berbayar
AI_PROVIDER=openrouter

# ── Bifrost Gateway Settings (Digunakan jika AI_PROVIDER=bifrost) ────────────
# Jalankan container Bifrost: docker compose -f docker-compose.bifrost.yml up -d
# Dashboard Web Bifrost ada di http://localhost:8080
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=bk-milo-token-gateway
BIFROST_MODEL=openai/gpt-4o-mini

# ── OpenRouter Settings (Digunakan jika AI_PROVIDER=openrouter) ──────────────
# Dapatkan API key gratis di: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free

# ── OpenAI Settings (Digunakan jika AI_PROVIDER=openai) ──────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── LLM Settings ─────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256

# Local LLM settings (used when AI_PROVIDER=local)
LOCAL_LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Whisper (Local ASR) ─────────────────────────────────────────────────────
# Options: tiny.en, base.en, small.en, medium.en, small, medium, large-v3
WHISPER_MODEL_SIZE=small.en
# Device: cuda (menggunakan NVIDIA GPU) atau cpu (auto-fallback jika tanpa GPU)
WHISPER_DEVICE=cuda

# ─── TTS Settings ─────────────────────────────────────────────────────────────
# OpenAI TTS model: tts-1 (fast) or tts-1-hd (high quality)
TTS_MODEL=tts-1
TTS_VOICE=nova

# ─── RAG Settings ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DB_PATH=./knowledge_base/chroma_db
CHROMA_COLLECTION_NAME=cefr_knowledge
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev (no install required), switch to PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./milo_dev.db
DATABASE_URL_SYNC=sqlite:///./milo_dev.db

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=MILO AI Backend
APP_VERSION=0.1.0
DEBUG=true
AUTO_TRANSLATE_RESPONSES=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Session Settings ──────────────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=10
SESSION_TIMEOUT_MINUTES=60

